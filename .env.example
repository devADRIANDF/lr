# Copia este archivo como .env.local (en local) o añade estas variables en
# Vercel: Project → Settings → Environment Variables.

# Base de datos (Supabase → Project Settings → Database → Connection string, modo "Transaction pooler")
DATABASE_URL=

# Sesión de usuarios. Pon una cadena larga y aleatoria. Sin ella nadie puede iniciar sesión.
JWT_SECRET=

# Panel de administración (/admin). Sin ellas el panel queda cerrado.
ADMIN_SECRET=
ADMIN_PASSWORD=

# Stripe (Developers → API keys y Developers → Webhooks)
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Opcional: dirección pública (para las vistas previas al compartir enlaces). Si no la pones,
# se usa el dominio de producción que da Vercel.
# NEXT_PUBLIC_SITE_URL=https://tudominio.com
