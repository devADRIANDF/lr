# Copia este archivo como .env.local (en local) o añade estas variables en
# Vercel: Project → Settings → Environment Variables.

# Base de datos (Supabase → botón Connect → "Transaction pooler"). Cambia [YOUR-PASSWORD] por la contraseña de la
# base de datos; si lleva símbolos como @ # / : ? resetéala con solo letras y números.
DATABASE_URL=

# Sesión de usuarios. Pon una cadena larga y aleatoria. Sin ella nadie puede iniciar sesión.
JWT_SECRET=

# Panel de administración (/admin). Sin ellas el panel queda cerrado.
ADMIN_SECRET=
ADMIN_PASSWORD=

# Stripe. Primero con las claves de pruebas (sk_test_...) y, cuando todo funcione, con las reales (sk_live_...).
# El whsec_ sale de Developers → Webhooks → tu endpoint (formato Snapshot). Pruebas y real tienen cada uno el suyo.
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Opcional: dirección pública (para las vistas previas al compartir enlaces). Si no la pones,
# se usa el dominio de producción que da Vercel.
# NEXT_PUBLIC_SITE_URL=https://tudominio.com
