# Copia este archivo como .env.local y rellena los valores reales

# Base de datos (Turso — necesaria para desplegar en Netlify/Vercel; en
# local puedes dejar esto vacío y usará un archivo local.db automáticamente)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Sesión de usuarios normales
JWT_SECRET=cambia-esto-por-algo-largo-y-aleatorio

# Panel de administración (/admin)
ADMIN_SECRET=cambia-esto-tambien
ADMIN_PASSWORD=cambia-esta-contrasena

# Stripe
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
